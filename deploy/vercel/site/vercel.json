{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/(.*)", "destination": "https://equivalent-let-engineering-del.trycloudflare.com/$1" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
