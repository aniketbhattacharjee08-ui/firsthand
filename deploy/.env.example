# Longhand public deployment. Copy to deploy/.env (gitignored: keep it out of
# the repo) and load it with the service manager; see deploy/README.md.

# --- paywall ---------------------------------------------------------------
# Name used in emails and shown by the frontend (the page calls itself Vervly).
LONGHAND_PRODUCT_NAME=Vervly
LONGHAND_PAYWALL=1
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
LONGHAND_SECRET=
LONGHAND_PUBLIC_URL=https://longhand.example.com
# SQLite file. Default is data/cache/billing.db inside the repo (gitignored).
LONGHAND_DB=/var/lib/longhand/billing.db
# Pricing is in credits; one credit buys LONGHAND_WORDS_PER_CREDIT words of a
# rewrite (rounded up per request, times an effort multiplier for extra
# candidates or rounds). With 100 words per credit, 10 free credits are
# 1,000 free words, and a 300-credit monthly plan is 30,000 words a month.
# These two must match the STRIPE_PLANS allowances and the plan labels.
LONGHAND_FREE_CREDITS=10
# Visitors who have not signed in: one free allowance per client address,
# then 402 and the sign-up page. An account created from that address
# inherits what the guest had left, so one address gets one allowance.
LONGHAND_GUESTS=1
LONGHAND_GUEST_CREDITS=10
# /app and the product API are public; the paywall above is the limit.
# 0 restores the sign-in wall in front of the app.
HUMANIZER_PUBLIC_APP=1
LONGHAND_WORDS_PER_CREDIT=100
LONGHAND_SESSION_DAYS=30
LONGHAND_MAGIC_LINK_MINUTES=15
LONGHAND_RATE_LIMIT=120/minute
LONGHAND_AUTH_RATE_LIMIT=5/minute
# Set to 1 only when uvicorn sits behind Caddy/nginx on the same host.
LONGHAND_TRUST_PROXY=1
# Never 1 in production: returns the login link in the HTTP response.
LONGHAND_DEV_LINKS=0
# Long random string; sent as X-Admin-Token to GET /api/models and POST /api/models/release.
LONGHAND_ADMIN_TOKEN=
# GPU work in flight at once, and how long a request waits for a slot before
# it is answered 503 busy (and refunded).
LONGHAND_MAX_INFLIGHT=1
LONGHAND_QUEUE_WAIT_S=20
# Parked streaming jobs unclaimed for this long are refunded (server TTL is 900).
LONGHAND_JOB_TTL_S=900
# Refund a rewrite that returned the whole document unchanged, at most N times
# per user per day.
LONGHAND_REFUND_UNCHANGED=1
LONGHAND_UNCHANGED_REFUNDS_PER_DAY=3
# Requests allowed to wait for the GPU slot at once; the rest get busy at once.
LONGHAND_MAX_WAITING=8
# One JSON line per charged request in $LONGHAND_LOG_DIR/requests.log; never the text.
LONGHAND_LOG_DIR=/Users/longhand/Library/Logs/longhand
# New accounts one address may create per day; disposable domains are refused.
LONGHAND_SIGNUPS_PER_IP_PER_DAY=3
LONGHAND_EMAIL_BLOCKLIST=
# Backups (deploy/backup.sh): destination dir and optional rclone remote.
LONGHAND_BACKUP_DIR=/Users/longhand/backups
RCLONE_REMOTE=

# --- sign in with Google and Apple (humanizer.api.oauth) -------------------
# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: $LONGHAND_PUBLIC_URL/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple Developer > Certificates, Identifiers & Profiles: a Services ID with
# Sign in with Apple, return URL $LONGHAND_PUBLIC_URL/api/auth/oauth/apple/callback
# (https only), and a Sign in with Apple key (.p8). Needs `pip install -e '.[oauth]'`.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=/path/to/AuthKey_XXXXXXXXXX.p8
# The redirect URIs above are built from this (falls back to the request host).
HUMANIZER_PUBLIC_URL=https://longhand.example.com

# --- email -----------------------------------------------------------------
# smtp://USER:PASSWORD@smtp.example.com:587 (STARTTLS) or smtps://...:465.
# Leave empty to print login links to the server log instead.
LONGHAND_SMTP_URL=
LONGHAND_MAIL_FROM=Vervly <no-reply@longhand.example.com>

# --- stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One-off credit packs: name:price_id:credits:label ; ...
# Credits bought this way never expire and sit on top of any plan allowance.
STRIPE_PRICES=starter:price_XXXX:50:$5 for 5,000 words;pro:price_YYYY:250:$20 for 25,000 words
# Plans: name:price_id:allowance_credits:interval:label ; ...
# interval is month, year or lifetime. allowance_credits is a MONTHLY
# allowance: once per UTC calendar month the balance is topped up to that
# number (never above it, so purchased packs are kept). A yearly plan is the
# same monthly allowance paid for a year; lifetime renews it forever. The
# monthly and yearly price_ids must be recurring Prices in Stripe; the
# lifetime one must be a one-time Price. The webhook endpoint must subscribe
# to checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted and invoice.paid. The billing portal
# (POST /api/billing/portal) needs a default portal configuration saved in
# the Stripe dashboard.
STRIPE_PLANS=monthly:price_MMMM:300:month:$9.99 a month for 30,000 words;yearly:price_YYYY:300:year:$79.99 a year for 30,000 words a month;lifetime:price_LLLL:200:lifetime:$299 once for 20,000 words a month

# --- humanizer engine (existing variables, unchanged) ---------------------
# The product judge is the free local surrogate; GPTZero runs only on a
# caller's own key, so this is optional and only used by benches.
GPTZERO_API_KEY=
# Apache-2.0 base plus the HIP adapter trained 2026-09-10 (.hip7b/NOTES.md):
# own-key GPTZero 16 of 18 AI paragraphs over two runs against the 3B base's
# 81%, all human controls unchanged. The 3B base is non-commercial.
HUMANIZER_BASE_MODEL=mlx-community/Qwen2.5-7B-4bit
HUMANIZER_BASE_ADAPTER=/Users/longhand/humanizer/data/adapters/hip7b-r4-it200
# Instruct checkpoint for the faithful style and the repair bridge draft (Apache 2.0).
HUMANIZER_INSTRUCT_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
HUMANIZER_MAX_RESIDENT_MODELS=2
HUMANIZER_MAX_RESIDENT_LLM=1
