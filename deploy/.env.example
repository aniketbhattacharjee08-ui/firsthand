# Longhand public deployment. Copy to deploy/.env (gitignored: keep it out of
# the repo) and load it with the service manager; see deploy/README.md.

# --- paywall ---------------------------------------------------------------
# Name used in emails and shown by the frontend (the page calls itself ReadsHuman).
LONGHAND_PRODUCT_NAME=ReadsHuman
LONGHAND_PAYWALL=1
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
LONGHAND_SECRET=
LONGHAND_PUBLIC_URL=https://longhand.example.com
# SQLite file. Default is data/cache/billing.db inside the repo (gitignored).
LONGHAND_DB=/var/lib/longhand/billing.db
LONGHAND_FREE_CREDITS=3
LONGHAND_WORDS_PER_CREDIT=300
LONGHAND_SESSION_DAYS=30
LONGHAND_MAGIC_LINK_MINUTES=15
LONGHAND_RATE_LIMIT=120/minute
LONGHAND_AUTH_RATE_LIMIT=5/minute
# Set to 1 only when uvicorn sits behind Caddy/nginx on the same host.
LONGHAND_TRUST_PROXY=1
# Never 1 in production: returns the login link in the HTTP response.
LONGHAND_DEV_LINKS=0
# Long random string; sent as X-Admin-Token to GET /api/models and POST /api/models/release.
LONGHAND_ADMIN_TOKEN=
# GPU work in flight at once, and how long a request waits for a slot before
# it is answered 503 busy (and refunded).
LONGHAND_MAX_INFLIGHT=1
LONGHAND_QUEUE_WAIT_S=20
# Parked streaming jobs unclaimed for this long are refunded (server TTL is 900).
LONGHAND_JOB_TTL_S=900
# Refund a rewrite that returned the whole document unchanged, at most N times
# per user per day.
LONGHAND_REFUND_UNCHANGED=1
LONGHAND_UNCHANGED_REFUNDS_PER_DAY=3
# Requests allowed to wait for the GPU slot at once; the rest get busy at once.
LONGHAND_MAX_WAITING=8
# One JSON line per charged request in $LONGHAND_LOG_DIR/requests.log; never the text.
LONGHAND_LOG_DIR=/Users/longhand/Library/Logs/longhand
# New accounts one address may create per day; disposable domains are refused.
LONGHAND_SIGNUPS_PER_IP_PER_DAY=3
LONGHAND_EMAIL_BLOCKLIST=
# Backups (deploy/backup.sh): destination dir and optional rclone remote.
LONGHAND_BACKUP_DIR=/Users/longhand/backups
RCLONE_REMOTE=

# --- email -----------------------------------------------------------------
# smtp://USER:PASSWORD@smtp.example.com:587 (STARTTLS) or smtps://...:465.
# Leave empty to print login links to the server log instead.
LONGHAND_SMTP_URL=
LONGHAND_MAIL_FROM=ReadsHuman <no-reply@longhand.example.com>

# --- stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# name:price_id:credits:label ; name:price_id:credits:label
STRIPE_PRICES=starter:price_XXXX:50:$5 for 50 credits;pro:price_YYYY:250:$20 for 250 credits

# --- humanizer engine (existing variables, unchanged) ---------------------
# The product judge is the free local surrogate; GPTZero runs only on a
# caller's own key, so this is optional and only used by benches.
GPTZERO_API_KEY=
# Apache-2.0 base plus the HIP adapter trained 2026-09-10 (.hip7b/NOTES.md):
# own-key GPTZero 16 of 18 AI paragraphs over two runs against the 3B base's
# 81%, all human controls unchanged. The 3B base is non-commercial.
HUMANIZER_BASE_MODEL=mlx-community/Qwen2.5-7B-4bit
HUMANIZER_BASE_ADAPTER=/Users/longhand/humanizer/data/adapters/hip7b-r4-it200
HUMANIZER_MAX_RESIDENT_MODELS=2
HUMANIZER_MAX_RESIDENT_LLM=1
