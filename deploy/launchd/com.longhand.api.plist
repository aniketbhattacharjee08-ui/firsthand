<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS service for the Longhand API on a Mac mini (the MLX engines need
     Apple Silicon). Install:
       sudo cp deploy/launchd/com.longhand.api.plist /Library/LaunchDaemons/
       sudo launchctl bootstrap system /Library/LaunchDaemons/com.longhand.api.plist
     Edit the three paths and the user. Environment comes from deploy/.env via
     the shell wrapper so secrets are not written into this file. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.longhand.api</string>
  <key>UserName</key><string>longhand</string>
  <key>WorkingDirectory</key><string>/Users/longhand/humanizer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source /Users/longhand/humanizer/deploy/.env; set +a; exec /Users/longhand/humanizer/.venv/bin/python -m humanizer.billing --host 127.0.0.1 --port 8000</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/longhand/Library/Logs/longhand.log</string>
  <key>StandardErrorPath</key><string>/Users/longhand/Library/Logs/longhand.err.log</string>
</dict>
</plist>
